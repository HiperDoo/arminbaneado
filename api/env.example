# Variables de entorno de la API. Defínelas en el panel de alwaysdata (no subas valores reales al repo).

ENV=prod

# Secretos largos y aleatorios: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
IP_SALT=
NONCE_SECRET=

# Cloudflare Turnstile (widget en modo Invisible, hostname arminbaneado.com)
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=arminbaneado.com,www.arminbaneado.com

# Webhook de Discord. ROTA el anterior: estaba publicado en el código.
DISCORD_WEBHOOK_URL=
# Opcional: canal privado para firmas en revisión
DISCORD_REVIEW_WEBHOOK_URL=

# Bot de Discord (solo lectura) para la tarjeta de perfil
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
PROFILES=armin:000000000000000000,darki:000000000000000000,emily:000000000000000000,karim:000000000000000000

ALLOWED_ORIGINS=https://arminbaneado.com,https://www.arminbaneado.com
# Proxies de confianza delante de la app (alwaysdata = 1)
TRUSTED_PROXY_HOPS=1

# Hitos del contador
MILESTONES=[{"count":50,"label":"El staff revisa el caso"},{"count":150,"label":"Votación del equipo de moderación"},{"count":300,"label":"Decisión final del owner"}]

# DB_PATH=/home/arminserver/data/firmas.db
